# Market data
SYMBOL=EURUSD=X
INTERVAL=5m
BARS_LOOKBACK=200

# Virtual account
STARTING_BALANCE=10000
POSITION_SIZE_USD=1000
SPREAD_PCT=0.02
SLIPPAGE_PCT=0.01

# Strategy params (MUST match the values used when the model was trained)
LEG_IN_LOOKBACK=10
CONTEXT_LOOKBACK=50
BASE_LEN_MIN=3
BASE_LEN_MAX=10
ATR_WINDOW=14
CONTRACTION_RATIO=0.5
DEDUP_GAP=5

CONFIDENCE_THRESHOLD=0.65
HORIZON_BARS=10
BREAKOUT_THRESHOLD_PCT=0.15

# Loop behavior
POLL_INTERVAL_SECONDS=60
RETRAIN_EVERY_N_OUTCOMES=25
ENABLE_RETRAINING=false

# Paths
MODEL_PATH=models/model.json
FEATURE_COLS_PATH=models/feature_cols.json
TRADE_LOG_PATH=logs/trade_log.csv
EQUITY_LOG_PATH=logs/equity_log.csv